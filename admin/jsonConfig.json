{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_connection": {
            "type": "panel",
            "label": "Connection",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "wolf.png",
                    "style": {
                        "width": "64px"
                    },
                    "sm": 12,
                    "md": 2,
                    "lg": 1
                },
                "bind": {
                    "type": "ip",
                    "label": "Adapter bind interface",
                    "listenOnAllPorts": true,
                    "newLine": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "port": {
                    "type": "number",
                    "label": "Port",
                    "min": 1,
                    "max": 65535,
                    "default": 12004,
                    "sm": 12,
                    "md": 3,
                    "lg": 2
                },
                "_hint": {
                    "type": "staticText",
                    "text": "Select an interface that allows external connections. The ISM8i must be configured to connect to this IP address and port.",
                    "newLine": true,
                    "sm": 12
                },
                "bool_status": {
                    "type": "checkbox",
                    "label": "Status as Boolean",
                    "help": "Switch states are written as true/false instead of text",
                    "newLine": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "bool_bar": {
                    "type": "checkbox",
                    "label": "Pressure in bar",
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "polling_interval": {
                    "type": "number",
                    "label": "Polling interval",
                    "help": "Seconds, 0 = off. Requests all values from the ISM8i.",
                    "min": 0,
                    "max": 2147482,
                    "default": 0,
                    "newLine": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                }
            }
        },
