{
  "name": "iobroker.wolf",
  "version": "1.7.0",
  "description": "Wolf Heating over ISM8i",
  "author": {
    "name": "smiling_Jack",
    "email": "smiling_Jack@ioBroker.net"
  },
  "contributors": [
    {
      "name": "smiling_Jack",
      "email": "smiling_Jack@ioBroker.net"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.wolf",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Heating",
    "Solar",
    "Wolf",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.wolf"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.wolf/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
